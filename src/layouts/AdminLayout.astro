---
/**
 * ==============================================================================
 * FILIPPO COCINAS | LAYOUT CMS: src/layouts/AdminLayout.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Envoltura estructural para el panel de administración privado de Filippo.
 * Proporciona barra superior con acceso rápido a la web pública, estado de
 * sesión y botón de cierre de sesión seguro.
 * ==============================================================================
 */

import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Panel de Contenidos | Filippo Cocinas' } = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full bg-filippo-linen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-full flex flex-col font-sans text-filippo-charcoal">
    
    <!-- Barra superior de administración -->
    <header class="bg-filippo-charcoal text-white border-b border-white/10 sticky top-0 z-30 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <div class="flex items-center gap-4">
          <a href="/admin" class="flex items-center gap-2">
            <span class="font-serif text-xl font-bold tracking-widest text-white uppercase">FILIPPO</span>
            <span class="text-[10px] uppercase tracking-widest text-filippo-oak font-semibold bg-white/10 px-2 py-0.5 rounded">CMS</span>
          </a>
        </div>

        <div class="flex items-center gap-4 text-xs">
          <a
            href="/"
            target="_blank"
            class="text-filippo-stone hover:text-white flex items-center gap-1.5 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span class="hidden sm:inline">Ver Sitio Web</span>
          </a>

          <button
            id="admin-logout-btn"
            type="button"
            class="bg-white/10 hover:bg-red-500/80 text-white px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>

      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
      <slot />
    </main>

    <!-- Toast de notificaciones flotante -->
    <div
      id="admin-toast"
      class="fixed bottom-6 right-6 hidden bg-filippo-charcoal text-white px-5 py-3 rounded-xl shadow-2xl border border-white/20 text-sm flex items-center gap-3 z-50 transition-all duration-300"
    >
      <span id="admin-toast-icon">✓</span>
      <span id="admin-toast-msg">Mensaje de notificación</span>
    </div>

    <script>
      // Manejador de cierre de sesión
      const logoutBtn = document.getElementById('admin-logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            await fetch('/api/admin/auth', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'logout' })
            });
            window.location.href = '/admin/login';
          } catch (e) {
            window.location.href = '/admin/login';
          }
        });
      }
    </script>
  </body>
</html>
