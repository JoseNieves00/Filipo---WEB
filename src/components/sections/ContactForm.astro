---
/**
 * ==============================================================================
 * FILIPPO COCINAS | SECCIÓN: ContactForm.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Módulo de conversión y captura de leads. Diseño minimalista y limpio para
 * reducir la fricción.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y la utilidad `src/utils/whatsapp.ts`.
 * Se monta en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';
import SectionHeader from '../common/SectionHeader.astro';

const { contact, brand, whatsapp } = siteContent;
const directWaUrl = getWhatsAppUrl(whatsapp.defaultMessages.general);
---

<section id="contacto" class="py-20 md:py-28 bg-filippo-cream/30 border-t border-filippo-stone/40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={contact.kicker}
      title={contact.title}
      description={contact.description}
      align="center"
    />

    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20">
      
      <!-- Formulario minimalista (Columna Izquierda 7 cols) -->
      <div class="lg:col-span-7">
        <h3 class="text-3xl font-serif text-filippo-charcoal mb-8">
          Agenda tu asesoría
        </h3>

        <form id="whatsapp-lead-form" class="space-y-8" data-phone={whatsapp.number || '573004567890'}>
          
          <!-- Campo 1: Nombre completo -->
          <div>
            <label for="lead-name" class="block text-sm text-filippo-charcoal/70 mb-2">
              {contact.form.nameLabel} *
            </label>
            <input
              type="text"
              id="lead-name"
              name="name"
              required
              class="w-full bg-transparent border-b border-filippo-stone/60 py-2 text-filippo-charcoal text-lg focus:outline-none focus:border-filippo-oak transition-colors"
            />
          </div>

          <!-- Campo 2: Tipo de proyecto -->
          <div>
            <label for="lead-project-type" class="block text-sm text-filippo-charcoal/70 mb-2">
              {contact.form.projectTypeLabel} *
            </label>
            <select
              id="lead-project-type"
              name="projectType"
              required
              class="w-full bg-transparent border-b border-filippo-stone/60 py-2 text-filippo-charcoal text-lg focus:outline-none focus:border-filippo-oak transition-colors cursor-pointer appearance-none"
            >
              {contact.form.projectTypes.map((type) => (
                <option value={type}>
                  {type}
                </option>
              ))}
            </select>
          </div>

          <!-- Campo 3: Ciudad o Sector -->
          <div>
            <label for="lead-city" class="block text-sm text-filippo-charcoal/70 mb-2">
              {contact.form.cityLabel} *
            </label>
            <input
              type="text"
              id="lead-city"
              name="city"
              required
              class="w-full bg-transparent border-b border-filippo-stone/60 py-2 text-filippo-charcoal text-lg focus:outline-none focus:border-filippo-oak transition-colors"
            />
          </div>

          <!-- Campo 4: Comentarios o dimensiones -->
          <div>
            <label for="lead-comments" class="block text-sm text-filippo-charcoal/70 mb-2">
              {contact.form.commentsLabel}
            </label>
            <textarea
              id="lead-comments"
              name="comments"
              rows="2"
              class="w-full bg-transparent border-b border-filippo-stone/60 py-2 text-filippo-charcoal text-lg focus:outline-none focus:border-filippo-oak transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Botón de envío -->
          <div class="pt-4">
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-3 bg-black hover:bg-filippo-oak hover:text-black text-white font-semibold py-4 px-6 rounded-full transition-colors duration-300 tracking-wider"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
              <span>{contact.form.submitButtonText}</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Información directa (Columna Derecha 5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <h4 class="text-2xl font-serif text-filippo-charcoal mb-6">
          Nuestras Oficinas
        </h4>
        <div class="space-y-6 text-filippo-charcoal/80 font-light text-lg">
          <div>
            <p class="font-medium text-filippo-charcoal">{brand.address}</p>
            <p>{brand.city}</p>
          </div>
          <div>
            <p class="font-medium text-filippo-charcoal">{brand.phoneDisplay}</p>
            <p>{brand.email}</p>
          </div>
          <div>
            <p>{brand.schedule}</p>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-filippo-stone/40">
          <a
            href={directWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-filippo-charcoal hover:text-filippo-oak transition-colors"
          >
            <span>Iniciar chat directo en WhatsApp</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Interceptor del formulario para construir el mensaje de WhatsApp dinámico
  const leadForm = document.getElementById('whatsapp-lead-form') as HTMLFormElement;

  if (leadForm) {
    leadForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('lead-name') as HTMLInputElement).value;
      const projectType = (document.getElementById('lead-project-type') as HTMLSelectElement).value;
      const city = (document.getElementById('lead-city') as HTMLInputElement).value;
      const comments = (document.getElementById('lead-comments') as HTMLTextAreaElement).value;

      // Mensaje estructurado claro y profesional
      const message = `Hola Filippo, mi nombre es ${name}.\n` +
        `Me interesa diseñar una cocina: ${projectType}.\n` +
        `Ubicación: ${city}.\n` +
        (comments.trim() ? `Detalles: "${comments.trim()}"\n` : '') +
        `¿Podemos coordinar una llamada o visita técnica?`;

      // Obtener el número configurado dinámicamente desde el dataset del formulario
      const rawPhone = leadForm.getAttribute('data-phone') || '573004567890';
      const cleanPhone = rawPhone.replace(/\D/g, '');
      const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;

      // Abrir WhatsApp en una nueva pestaña
      window.open(waUrl, '_blank');
    });
  }
</script>
