---
/**
 * ==============================================================================
 * FILIPPO COCINAS | SECCIÓN: Testimonials.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Presentar opiniones con un enfoque minimalista, resaltando únicamente la
 * voz del cliente en gran formato y con tipografía cuidada.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import SectionHeader from '../common/SectionHeader.astro';

const { testimonials } = siteContent;
---

<section id="testimonios" class="py-20 md:py-28 bg-filippo-linen border-t border-filippo-stone/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={testimonials.kicker}
      title={testimonials.title}
      description={testimonials.description}
      align="center"
    />

    <!-- Layout tipográfico minimalista -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 mt-12">
      {testimonials.items.map((t) => (
        <div class="flex flex-col justify-between">
          <div>
            <p class="text-xl lg:text-2xl text-filippo-charcoal font-serif italic leading-relaxed mb-8">
              "{t.quote}"
            </p>
          </div>

          <div class="pt-6 border-t border-filippo-charcoal/20">
            <p class="font-bold text-sm text-filippo-charcoal uppercase tracking-wider mb-1">
              {t.author}
            </p>
            <p class="text-xs text-filippo-muted">
              {t.location} · <span class="text-filippo-charcoal font-medium">{t.projectType}</span>
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
