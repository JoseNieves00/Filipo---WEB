---
/**
 * ==============================================================================
 * FILIPPO COCINAS | SECCIÓN: Testimonials.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Presentar opiniones reales de propietarios residenciales y arquitectos que
 * instalaron cocinas con Filippo. Aumenta la confianza y acelera la conversión.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import SectionHeader from '../common/SectionHeader.astro';

const { testimonials } = siteContent;
---

<section id="testimonios" class="py-20 md:py-28 bg-filippo-cream/60 border-t border-filippo-stone/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={testimonials.kicker}
      title={testimonials.title}
      description={testimonials.description}
      align="center"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.items.map((t) => (
        <div class="bg-filippo-white rounded-2xl p-8 border border-filippo-stone/70 shadow-soft hover:shadow-card transition-all duration-300 flex flex-col justify-between">
          
          <div>
            <!-- Calificación 5 estrellas doradas cálidas -->
            <div class="flex items-center gap-1 mb-6 text-filippo-oak">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Cita del testimonio -->
            <p class="text-sm md:text-base text-filippo-charcoal/90 font-serif italic leading-relaxed mb-6">
              "{t.quote}"
            </p>
          </div>

          <!-- Autor y detalles del proyecto -->
          <div class="pt-4 border-t border-filippo-stone/40">
            <p class="font-serif font-bold text-sm text-filippo-charcoal">
              {t.author}
            </p>
            <p class="text-xs text-filippo-muted">
              {t.location} · <span class="text-filippo-oak font-medium">{t.projectType}</span>
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
