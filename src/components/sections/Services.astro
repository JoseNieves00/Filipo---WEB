---
/**
 * ==============================================================================
 * FILIPPO COCINAS | SECCIÓN: Services.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Presentar los pilares fundamentales de servicio con un diseño limpio,
 * minimalista y altamente legible.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import SectionHeader from '../common/SectionHeader.astro';

const { services } = siteContent;
---

<section id="servicios" class="py-20 md:py-28 bg-filippo-white border-t border-filippo-stone/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={services.kicker}
      title={services.title}
      description={services.description}
      align="center"
    />

    <!-- Cuadrícula de servicios minimalista -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-12">
      {services.items.map((item, index) => (
        <div class="flex flex-col sm:flex-row gap-6 p-8 lg:p-10 bg-filippo-cream rounded-3xl group transition-transform duration-500 hover:-translate-y-1">
          <div class="shrink-0">
            <span class="text-4xl lg:text-5xl font-serif text-filippo-oak/50 group-hover:text-filippo-oak transition-colors">
              0{index + 1}
            </span>
          </div>
          <div>
            <h3 class="text-2xl lg:text-3xl font-serif text-filippo-charcoal mb-4">
              {item.title}
            </h3>
            <p class="text-base lg:text-lg text-filippo-muted leading-relaxed font-light">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
