---
/**
 * ==============================================================================
 * FILIPPO | SECCIÓN: ProductCatalog.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Catálogo principal de líneas de producto en la Home. Muestra cada categoría
 * con un enfoque altamente visual e inmersivo (estilo Apple), minimizando 
 * texto y maximizando la presencia de las fotografías.
 *
 * RELACIÓN:
 * Consume `products` de `src/data/siteContent.json`. Cada producto enlaza a
 * su ruta dinámica `/${product.slug}`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';
import SectionHeader from '../common/SectionHeader.astro';

const products = (siteContent.products || []).filter((p) => p.published);
---

<section id="productos" class="py-20 md:py-28 bg-filippo-white border-t border-filippo-stone/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker="NUESTRAS LÍNEAS DE DISEÑO"
      title="Soluciones de autor"
      description="Explora nuestras especialidades arquitectónicas. Cada categoría cuenta con fabricación a medida y acabados de alta gama."
      align="center"
    />

    <!-- Grid de catálogo inmersivo (Minimalista) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10 mt-12">
      {products.map((product) => {
        const productWaUrl = getWhatsAppUrl(
          product.whatsappMessage || `Hola Filippo, me interesa cotizar ${product.title}.`
        );

        return (
          <article class="group relative overflow-hidden rounded-3xl bg-black">
            <!-- Imagen inmersiva -->
            <a href={`/${product.slug}`} class="block aspect-[4/5] sm:aspect-square md:aspect-[4/3] lg:aspect-square overflow-hidden">
              <img
                src={product.image}
                alt={product.title}
                class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100"
                loading="lazy"
              />
              <!-- Gradiente sutil para contraste del texto -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            </a>

            <!-- Contenido minimalista sobre la imagen -->
            <div class="absolute bottom-0 left-0 right-0 p-8 sm:p-10 flex flex-col items-center text-center">
              <h3 class="text-3xl sm:text-4xl font-serif text-white mb-6">
                <a href={`/${product.slug}`}>
                  {product.title}
                </a>
              </h3>

              <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                <a
                  href={`/${product.slug}`}
                  class="px-8 py-3.5 rounded-full bg-white/10 backdrop-blur-md text-white text-sm font-semibold tracking-wide hover:bg-white hover:text-black transition-colors"
                >
                  Explorar
                </a>
                <a
                  href={productWaUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-8 py-3.5 rounded-full bg-filippo-oak text-black text-sm font-bold tracking-wide hover:bg-filippo-oak-dark transition-colors"
                >
                  Cotizar
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
