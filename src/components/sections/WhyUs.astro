---
/**
 * ==============================================================================
 * FILIPPO | SECCIÓN: WhyUs.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Sección "Por qué elegirnos / Ventajas clave". Diseño minimalista y audaz
 * (estilo Apple) para transmitir confianza a través de tipografía de gran formato.
 *
 * RELACIÓN:
 * Consume `whyUs` de `src/data/siteContent.json`. Se renderiza en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import SectionHeader from '../common/SectionHeader.astro';

const { whyUs } = siteContent;
---

<section id="por-que-elegirnos" class="py-20 md:py-28 bg-filippo-white border-t border-filippo-stone/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={whyUs.kicker}
      title={whyUs.title}
      description={whyUs.description}
      align="center"
    />

    <!-- Cuadrícula minimalista y audaz -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mt-12">
      {whyUs.items.map((item) => (
        <div class="bg-black rounded-3xl p-8 lg:p-10 flex flex-col group transition-transform duration-500 hover:-translate-y-1">
          <span class="block font-serif text-5xl lg:text-6xl text-filippo-oak mb-8">
            {item.number}
          </span>
          <h3 class="text-2xl font-serif text-white mb-4">
            {item.title}
          </h3>
          <p class="text-base text-white/70 font-light leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
