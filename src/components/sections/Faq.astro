---
/**
 * ==============================================================================
 * FILIPPO COCINAS | SECCIÓN: Faq.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Acordeón accesible de preguntas frecuentes. Diseño minimalista con líneas
 * simples y gran tipografía.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';
import SectionHeader from '../common/SectionHeader.astro';

const { faq } = siteContent;
const faqWaUrl = getWhatsAppUrl("Hola Filippo, tengo una consulta específica que no encontré en las preguntas frecuentes.");
---

<section id="faq" class="py-20 md:py-28 bg-filippo-white border-t border-filippo-stone/40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={faq.kicker}
      title={faq.title}
      description={faq.description}
      align="center"
    />

    <!-- Acordeón interactivo minimalista -->
    <div class="mt-12" id="faq-accordion">
      {faq.items.map((item, idx) => (
        <div class="border-b border-filippo-stone/60 transition-all duration-200">
          <button
            type="button"
            class="faq-trigger w-full py-6 text-left flex items-center justify-between gap-4 focus:outline-none group"
            aria-expanded="false"
            aria-controls={`faq-answer-${idx}`}
            id={`faq-btn-${idx}`}
          >
            <span class="font-serif text-xl sm:text-2xl text-filippo-charcoal group-hover:text-filippo-oak transition-colors">
              {item.question}
            </span>
            <span class="faq-icon text-filippo-charcoal/50 group-hover:text-filippo-oak shrink-0 transition-transform duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>

          <div
            id={`faq-answer-${idx}`}
            role="region"
            aria-labelledby={`faq-btn-${idx}`}
            class="faq-content hidden pb-8 text-base text-filippo-muted leading-relaxed font-light"
          >
            <p>{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Llamada complementaria minimalista -->
    <div class="mt-16 text-center">
      <a
        href={faqWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-filippo-charcoal hover:text-filippo-oak transition-colors border-b border-transparent hover:border-filippo-oak pb-1"
      >
        <span>¿Tienes otra consulta? Habla con un arquitecto por WhatsApp</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  // Control interactivo del acordeón de preguntas
  const triggers = document.querySelectorAll('.faq-trigger');

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      const icon = btn.querySelector('.faq-icon');

      // Alternar estado actual
      btn.setAttribute('aria-expanded', String(!isExpanded));
      if (panel) {
        panel.classList.toggle('hidden');
      }
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
  });
</script>
