---
/**
 * ==============================================================================
 * FILIPPO COCINAS | SECCIÓN: Faq.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Acordeón accesible de preguntas frecuentes. Resuelve dudas críticas sobre
 * tiempos, visitas técnicas a domicilio, herrajes europeos, pagos y garantías.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta en `src/pages/index.astro`.
 *
 * ACCESIBILIDAD:
 * - Botones con aria-expanded y control de foco.
 * - Paneles con role="region" vinculados por aria-controls.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';
import SectionHeader from '../common/SectionHeader.astro';

const { faq } = siteContent;
const faqWaUrl = getWhatsAppUrl("Hola Filippo, tengo una consulta específica que no encontré en las preguntas frecuentes.");
---

<section id="faq" class="py-20 md:py-28 bg-filippo-white border-t border-filippo-stone/40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeader
      kicker={faq.kicker}
      title={faq.title}
      description={faq.description}
      align="center"
    />

    <!-- Acordeón interactivo -->
    <div class="space-y-4" id="faq-accordion">
      {faq.items.map((item, idx) => (
        <div class="border border-filippo-stone/70 rounded-xl overflow-hidden bg-filippo-linen/30 transition-all duration-200">
          <button
            type="button"
            class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none focus:bg-filippo-linen/60"
            aria-expanded="false"
            aria-controls={`faq-answer-${idx}`}
            id={`faq-btn-${idx}`}
          >
            <span class="font-serif font-semibold text-base sm:text-lg text-filippo-charcoal">
              {item.question}
            </span>
            <span class="faq-icon text-filippo-oak shrink-0 transition-transform duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>

          <div
            id={`faq-answer-${idx}`}
            role="region"
            aria-labelledby={`faq-btn-${idx}`}
            class="faq-content hidden px-6 pb-6 pt-1 text-sm sm:text-base text-filippo-muted leading-relaxed font-light border-t border-filippo-stone/30"
          >
            <p>{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Llamada complementaria a WhatsApp si aún tienen dudas -->
    <div class="mt-12 text-center bg-filippo-cream/60 p-6 rounded-2xl border border-filippo-stone/60">
      <p class="text-sm text-filippo-charcoal font-medium mb-3">
        ¿Tienes una pregunta específica sobre tu espacio o planos?
      </p>
      <a
        href={faqWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-semibold text-filippo-oak hover:text-filippo-oak-dark transition-colors"
      >
        <span>Consultar directamente a un arquitecto por WhatsApp</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  // Control interactivo del acordeón de preguntas
  const triggers = document.querySelectorAll('.faq-trigger');

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      const icon = btn.querySelector('.faq-icon');

      // Alternar estado actual
      btn.setAttribute('aria-expanded', String(!isExpanded));
      if (panel) {
        panel.classList.toggle('hidden');
      }
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
  });
</script>
