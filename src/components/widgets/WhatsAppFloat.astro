---
/**
 * ==============================================================================
 * FILIPPO COCINAS | WIDGET: WhatsAppFloat.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Botón flotante persistente de WhatsApp ubicado en la esquina inferior derecha.
 * Garantiza un punto de contacto constante y sin fricción a lo largo de todo el
 * desplazamiento de la página.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y la utilidad `src/utils/whatsapp.ts`.
 * Se incluye globalmente en `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const waFloatUrl = getWhatsAppUrl(siteContent.whatsapp.defaultMessages.floatingButton);
---

<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3 group">
  
  <!-- Tooltip sutil visible en pantallas medianas y grandes -->
  <a
    href={waFloatUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden sm:flex items-center gap-2 bg-filippo-white/95 backdrop-blur-md px-4 py-2.5 rounded-full shadow-floating border border-filippo-stone/80 text-xs font-semibold text-filippo-charcoal hover:text-filippo-oak transition-all duration-300 transform group-hover:-translate-x-1"
  >
    <span class="w-2 h-2 rounded-full bg-whatsapp animate-ping"></span>
    <span>¿Dudas sobre tu cocina? Hablemos</span>
  </a>

  <!-- Botón flotante principal de WhatsApp con animación de pulso -->
  <a
    href={waFloatUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-whatsapp hover:bg-whatsapp-dark text-white flex items-center justify-center shadow-floating transition-all duration-300 animate-wa-pulse focus:outline-none focus:ring-4 focus:ring-whatsapp/40"
    aria-label="Contactar a Filippo Cocinas por WhatsApp"
    title="Chatear por WhatsApp"
  >
    <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
    </svg>
  </a>

</div>
