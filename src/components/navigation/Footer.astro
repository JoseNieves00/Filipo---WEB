---
/**
 * ==============================================================================
 * FILIPPO COCINAS | COMPONENTE: Footer.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Pie de página arquitectónico con fondo sobrio. Contiene datos de contacto,
 * horario de oficinas, enlaces a redes sociales y enlace discreto de acceso
 * administrativo al CMS.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta al final de `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const waFooterUrl = getWhatsAppUrl(siteContent.whatsapp.defaultMessages.general);
const currentYear = new Date().getFullYear();
---

<footer class="bg-filippo-dark text-filippo-linen pt-16 pb-12 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Columna 1: Identidad y filosofía de marca -->
      <div class="space-y-4">
        <span class="font-serif text-3xl tracking-widest text-white uppercase font-bold block">
          {siteContent.brand.name}
        </span>
        <span class="text-[10px] tracking-[0.25em] text-filippo-oak uppercase font-medium block -mt-2">
          STUDIO DE COCINAS
        </span>
        <p class="text-sm text-filippo-stone/70 leading-relaxed font-light pt-2">
          {siteContent.brand.description}
        </p>
      </div>

      <!-- Columna 2: Enlaces de navegación rápida -->
      <div>
        <h4 class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold mb-5">
          Navegación
        </h4>
        <ul class="space-y-2.5 text-sm text-filippo-stone/80">
          <li><a href="#servicios" class="hover:text-white transition-colors">Servicios</a></li>
          <li><a href="#galeria" class="hover:text-white transition-colors">Proyectos Realizados</a></li>
          <li><a href="#proceso" class="hover:text-white transition-colors">Método de Trabajo</a></li>
          <li><a href="#testimonios" class="hover:text-white transition-colors">Testimonios</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="#contacto" class="hover:text-white transition-colors">Agendar Cita</a></li>
        </ul>
      </div>

      <!-- Columna 3: oficinas & Horarios -->
      <div>
        <h4 class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold mb-5">
          oficinas & Contacto
        </h4>
        <ul class="space-y-3 text-sm text-filippo-stone/80">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-filippo-oak shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteContent.brand.address}, {siteContent.brand.city}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-filippo-oak shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{siteContent.brand.phoneDisplay}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-filippo-oak shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs leading-relaxed">{siteContent.brand.schedule}</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Canal directo y redes -->
      <div>
        <h4 class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold mb-5">
          Canal Directo
        </h4>
        <p class="text-sm text-filippo-stone/70 mb-4 font-light">
          Atendemos consultas de diseño y proyectos residenciales directamente en WhatsApp:
        </p>
        <a
          href={waFooterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-whatsapp/20 hover:bg-whatsapp text-white border border-whatsapp/40 hover:border-whatsapp text-xs font-semibold px-4 py-2.5 rounded-full transition-all duration-300 mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-whatsapp animate-ping"></span>
          <span>WhatsApp Directo</span>
        </a>

        <!-- Redes sociales -->
        <div class="flex items-center gap-4 text-filippo-stone/70">
          <a href={siteContent.brand.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href={siteContent.brand.social.pinterest} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Pinterest">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.334 1.357-.057.241-.188.291-.437.175-1.639-.763-2.665-3.159-2.665-5.084 0-4.14 3.008-7.942 8.679-7.942 4.554 0 8.096 3.246 8.096 7.585 0 4.526-2.854 8.169-6.814 8.169-1.331 0-2.582-.692-3.009-1.508l-.819 3.125c-.297 1.134-1.101 2.556-1.639 3.424 1.213.375 2.503.578 3.84.578 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Barra inferior: Copyright y acceso al panel de administración -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-filippo-stone/60 gap-4">
      <p>
        © {currentYear} {siteContent.brand.legalName}. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        <span>Diseñado para habitar.</span>
        <!-- Enlace discreto al panel CMS para que el cliente lo tenga siempre accesible -->
        <a
          href="/admin"
          class="text-filippo-stone/40 hover:text-filippo-oak transition-colors flex items-center gap-1"
          title="Panel de administración de contenidos"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Acceso Privado</span>
        </a>
      </div>
    </div>
  </div>
</footer>
