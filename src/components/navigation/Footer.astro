---
/**
 * ==============================================================================
 * FILIPPO COCINAS | COMPONENTE: Footer.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Pie de página arquitectónico con fondo sobrio. Contiene datos de contacto,
 * horario de oficinas, enlaces a redes sociales y enlace discreto de acceso
 * administrativo al CMS.
 *
 * RELACIÓN:
 * Consume `src/data/siteContent.json` y se monta al final de `src/pages/index.astro`.
 * ==============================================================================
 */

import siteContent from '../../data/siteContent.json';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const waFooterUrl = getWhatsAppUrl(siteContent.whatsapp.defaultMessages.general);
const currentYear = new Date().getFullYear();
---

<footer class="bg-filippo-dark text-filippo-linen pt-16 pb-12 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Columna 1: Identidad y filosofía de marca -->
      <div class="space-y-4">
        <span class="font-serif text-3xl tracking-widest text-white uppercase font-bold block">
          {siteContent.brand.name}
        </span>

        <p class="text-sm text-filippo-stone/70 leading-relaxed font-light pt-2">
          {siteContent.brand.description}
        </p>
      </div>

      <!-- Columna 2: Enlaces de navegación rápida -->
      <div>
        <h4 class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold mb-5">
          Navegación
        </h4>
        <ul class="space-y-2.5 text-sm text-filippo-stone/80">
          <li><a href="/#productos" class="hover:text-white transition-colors">Productos</a></li>
          <li><a href="/#por-que-elegirnos" class="hover:text-white transition-colors">Por qué elegirnos</a></li>
          <li><a href="/#galeria" class="hover:text-white transition-colors">Proyectos Realizados</a></li>
          <li><a href="/#testimonios" class="hover:text-white transition-colors">Testimonios</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="/#contacto" class="hover:text-white transition-colors">Agendar Cita</a></li>
        </ul>
      </div>

      <!-- Columna 3: oficinas & Horarios -->
      <div>
        <h4 class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold mb-5">
          oficinas & Contacto
        </h4>
        <ul class="space-y-3 text-sm text-filippo-stone/80">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-filippo-oak shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteContent.brand.address}, {siteContent.brand.city}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-filippo-oak shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{siteContent.brand.phoneDisplay}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-filippo-oak shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs leading-relaxed">{siteContent.brand.schedule}</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Canal directo y redes -->
      <div>
        <h4 class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold mb-5">
          Canal Directo
        </h4>
        <p class="text-sm text-filippo-stone/70 mb-4 font-light">
          Atendemos consultas de diseño y proyectos residenciales directamente en WhatsApp:
        </p>
        <a
          href={waFooterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-whatsapp/20 hover:bg-whatsapp text-white border border-whatsapp/40 hover:border-whatsapp text-xs font-semibold px-4 py-2.5 rounded-full transition-all duration-300 mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-whatsapp animate-ping"></span>
          <span>WhatsApp Directo</span>
        </a>

        <!-- Redes sociales -->
        <div class="flex items-center gap-4 text-filippo-stone/70">
          {siteContent.brand.social.instagram && (
            <a href={siteContent.brand.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Instagram">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {siteContent.brand.social.facebook && (
            <a href={siteContent.brand.social.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Facebook">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {siteContent.brand.social.tiktok && (
            <a href={siteContent.brand.social.tiktok} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="TikTok">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.76 1.3-.04 2.47-.79 3.01-1.93.4-.8.5-1.72.48-2.62.03-5.27.01-10.54.02-15.81z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

    </div>

    <!-- Barra inferior: Copyright -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-filippo-stone/60 gap-4">
      <p>
        © {currentYear} {siteContent.brand.legalName}. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">

      </div>
    </div>
  </div>
</footer>
