---
/**
 * ==============================================================================
 * FILIPPO COCINAS | COMPONENTE: Navbar.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Barra de navegación superior fija (sticky). Facilita el desplazamiento
 * fluido por anclas en dispositivos móviles y de escritorio, con llamada directa
 * a WhatsApp.
 *
 * RELACIÓN:
 * Importa la utilidad `src/utils/whatsapp.ts` y se monta en `src/pages/index.astro`.
 *
 * ACCESIBILIDAD:
 * - Menú responsive con control de estado ARIA (aria-expanded).
 * - Enlaces de ancla con desplazamiento suave.
 * ==============================================================================
 */

import { getWhatsAppUrl } from '../../utils/whatsapp';
import siteContent from '../../data/siteContent.json';

const whatsappNavUrl = getWhatsAppUrl(siteContent.whatsapp.defaultMessages.hero);

const navLinks = [
  { href: '#productos', label: 'Productos' },
  { href: '#por-que-elegirnos', label: 'Por qué elegirnos' },
  { href: '#galeria', label: 'Proyectos' },
  { href: '#testimonios', label: 'Opiniones' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 w-full glass-header border-b border-filippo-charcoal/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logotipo Filippo de autor -->
    <a href="#" class="flex items-center group focus:outline-none">
      {siteContent.brand.logoUrl ? (
        <img src={siteContent.brand.logoUrl} alt={siteContent.brand.name} class="h-10 md:h-12 w-auto object-contain" />
      ) : (
        <span class="font-serif text-2xl md:text-3xl tracking-widest text-filippo-charcoal uppercase font-bold group-hover:text-filippo-oak transition-colors">
          {siteContent.brand.name}
        </span>
      )}
    </a>

    <!-- Navegación de escritorio (menú de anclas) -->
    <nav class="hidden md:flex items-center space-x-8" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-filippo-charcoal/80 hover:text-filippo-oak tracking-wide transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-filippo-oak hover:after:w-full after:transition-all after:duration-300"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Botón CTA de Cotizar en el header -->
    <div class="hidden sm:flex items-center space-x-4">
      <a
        href={whatsappNavUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-filippo-oak hover:bg-filippo-oak-dark text-black text-xs uppercase tracking-wider font-semibold px-5 py-2.5 rounded-full shadow-sm hover:shadow-md hover:scale-[1.02] transition-all duration-300"
      >
        <!-- Icono minimalista de WhatsApp SVG -->
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>Cotizar Proyecto</span>
      </a>
    </div>

    <!-- Botón hamburguesa móvil -->
    <div class="flex items-center md:hidden">
      <button
        id="mobile-menu-button"
        type="button"
        class="text-white p-2 focus:outline-none"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable para móviles -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-black border-b border-white/10 px-6 pt-4 pb-8 transition-all"
  >
    <nav class="flex flex-col space-y-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-lg font-serif text-white hover:text-filippo-oak py-1 border-b border-white/10"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4">
        <a
          href={whatsappNavUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full bg-filippo-oak hover:bg-filippo-oak-dark text-black py-3.5 rounded-full font-semibold shadow-md text-sm transition-all"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
          <span>Cotizar por WhatsApp</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Control interactivo del menú móvil
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuButton && mobileMenu && hamburgerIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Cierra el menú móvil al hacer clic en un enlace de ancla
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
