---
/**
 * ==============================================================================
 * FILIPPO COCINAS | DASHBOARD CMS: src/pages/admin/index.astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Panel de administración interactivo para el cliente. Permite editar textos,
 * modificar el número de WhatsApp, gestionar la galería de proyectos (subir,
 * optimizar y eliminar imágenes), y administrar FAQs y testimonios sin tocar código.
 *
 * SEGURIDAD:
 * Verifica la cookie de sesión del administrador. Si no existe, redirige a /admin/login.
 *
 * RELACIÓN:
 * Carga el contenido inicial de `src/data/siteContent.json` y envía peticiones
 * a `/api/admin/content` y `/api/admin/upload`.
 * ==============================================================================
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import siteContent from '../../data/siteContent.json';

// Verificación de autenticación en el servidor (Astro SSR)
const sessionCookie = Astro.cookies.get('filippo_admin_session');
if (!sessionCookie || sessionCookie.value !== 'filippo_studio_secret_token_session') {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Panel de Gestión | Filippo Cocinas">
  
  <!-- Encabezado de la página de administración -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-filippo-stone/60">
    <div>
      <span class="text-xs uppercase tracking-widest-caps text-filippo-oak font-semibold">
        Gestor de Contenido & Conversión
      </span>
      <h1 class="font-serif text-3xl font-bold text-filippo-charcoal mt-1">
        Administración de Filippo Cocinas
      </h1>
      <p class="text-xs text-filippo-muted mt-1 font-light">
        Los cambios que guardes aquí se reflejan instantáneamente en la página web pública.
      </p>
    </div>

    <!-- Botón global de guardar cambios -->
    <div class="flex items-center gap-3">
      <button
        id="save-all-btn"
        type="button"
        class="inline-flex items-center gap-2 bg-filippo-charcoal hover:bg-filippo-dark text-white px-6 py-3 rounded-full text-xs uppercase tracking-wider font-semibold shadow-md hover:shadow-lg transition-all duration-300"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        <span>Guardar Cambios</span>
      </button>
    </div>
  </div>

  <!-- Pestañas de navegación interna del CMS -->
  <div class="flex flex-wrap gap-2 border-b border-filippo-stone/60 pb-3 mb-8" id="admin-tabs">
    <button
      type="button"
      class="tab-btn px-4 py-2 rounded-xl text-xs uppercase tracking-wider font-semibold bg-filippo-charcoal text-white transition-all"
      data-tab="tab-whatsapp"
    >
      1. WhatsApp & Contacto
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2 rounded-xl text-xs uppercase tracking-wider font-semibold bg-filippo-white text-filippo-charcoal/70 border border-filippo-stone/70 hover:text-filippo-charcoal transition-all"
      data-tab="tab-hero"
    >
      2. Portada & Hero
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2 rounded-xl text-xs uppercase tracking-wider font-semibold bg-filippo-white text-filippo-charcoal/70 border border-filippo-stone/70 hover:text-filippo-charcoal transition-all"
      data-tab="tab-gallery"
    >
      3. Galería de Proyectos
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2 rounded-xl text-xs uppercase tracking-wider font-semibold bg-filippo-white text-filippo-charcoal/70 border border-filippo-stone/70 hover:text-filippo-charcoal transition-all"
      data-tab="tab-faqs"
    >
      4. Preguntas Frecuentes
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2 rounded-xl text-xs uppercase tracking-wider font-semibold bg-filippo-white text-filippo-charcoal/70 border border-filippo-stone/70 hover:text-filippo-charcoal transition-all"
      data-tab="tab-testimonials"
    >
      5. Testimonios
    </button>
  </div>

  <!-- CONTENIDO DE LAS PESTAÑAS -->
  <div class="space-y-8">
    
    <!-- =========================================================================
     * PESTAÑA 1: WHATSAPP Y DATOS DE CONTACTO
     * ========================================================================= -->
    <div id="tab-whatsapp" class="tab-panel block space-y-6">
      
      <!-- Bloque de WhatsApp -->
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-whatsapp text-white flex items-center justify-center">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
          </div>
          <div>
            <h2 class="font-serif text-xl font-bold text-filippo-charcoal">Configuración de WhatsApp</h2>
            <p class="text-xs text-filippo-muted">Todos los botones de la página conectan a este número.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Número de WhatsApp (con código de país, sin '+' ni espacios)
            </label>
            <input
              type="text"
              id="field-wa-number"
              value={siteContent.whatsapp.number}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm focus:outline-none focus:border-filippo-charcoal"
              placeholder="573004567890"
            />
            <p class="text-[11px] text-filippo-muted mt-1.5">
              Ejemplo: 57 (Colombia) + 3004567890 = <strong>573004567890</strong>
            </p>
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Mensaje del Botón Flotante
            </label>
            <input
              type="text"
              id="field-wa-float"
              value={siteContent.whatsapp.defaultMessages.floatingButton}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm focus:outline-none focus:border-filippo-charcoal"
            />
          </div>

          <div class="md:col-span-2">
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Mensaje del Botón Hero (Portada)
            </label>
            <input
              type="text"
              id="field-wa-hero"
              value={siteContent.whatsapp.defaultMessages.hero}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm focus:outline-none focus:border-filippo-charcoal"
            />
          </div>
        </div>
      </div>

      <!-- Bloque de Showroom y Redes -->
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft">
        <h2 class="font-serif text-xl font-bold text-filippo-charcoal mb-4">
          Datos de Showroom y Marca
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Nombre de la Marca
            </label>
            <input
              type="text"
              id="field-brand-name"
              value={siteContent.brand.name}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Teléfono de Showroom (Texto visible)
            </label>
            <input
              type="text"
              id="field-brand-phone"
              value={siteContent.brand.phoneDisplay}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Correo Electrónico
            </label>
            <input
              type="email"
              id="field-brand-email"
              value={siteContent.brand.email}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Dirección y Ciudad
            </label>
            <input
              type="text"
              id="field-brand-address"
              value={siteContent.brand.address}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>

          <div class="md:col-span-2">
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Horario de Atención
            </label>
            <input
              type="text"
              id="field-brand-schedule"
              value={siteContent.brand.schedule}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>
        </div>
      </div>

    </div>

    <!-- =========================================================================
     * PESTAÑA 2: HERO Y TEXTOS PRINCIPALES
     * ========================================================================= -->
    <div id="tab-hero" class="tab-panel hidden space-y-6">
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft space-y-6">
        <h2 class="font-serif text-xl font-bold text-filippo-charcoal">
          Textos del Hero (Portada Principal)
        </h2>

        <div>
          <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
            Titular Principal (Headline)
          </label>
          <input
            type="text"
            id="field-hero-headline"
            value={siteContent.hero.headline}
            class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
          />
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
            Subtítulo Persuasivo
          </label>
          <textarea
            id="field-hero-subheadline"
            rows="3"
            class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm resize-none"
          >{siteContent.hero.subheadline}</textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Texto del Botón Principal
            </label>
            <input
              type="text"
              id="field-hero-cta"
              value={siteContent.hero.ctaText}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Insignia de Confianza / Garantía
            </label>
            <input
              type="text"
              id="field-hero-badge"
              value={siteContent.hero.badgeText}
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-filippo-charcoal text-sm"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================================
     * PESTAÑA 3: GALERÍA DE PROYECTOS (SUBIDA Y OPTIMIZACIÓN WEBP)
     * ========================================================================= -->
    <div id="tab-gallery" class="tab-panel hidden space-y-8">
      
      <!-- Formulario para agregar un nuevo proyecto -->
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft">
        <h2 class="font-serif text-xl font-bold text-filippo-charcoal mb-2">
          Agregar Nuevo Proyecto a la Galería
        </h2>
        <p class="text-xs text-filippo-muted mb-6">
          Sube la fotografía de la cocina. El sistema la optimizará automáticamente a formato WebP ligero sin perder calidad.
        </p>

        <form id="add-project-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Nombre del Proyecto *
            </label>
            <input
              type="text"
              id="new-proj-title"
              required
              placeholder="Ej. Casa Bosque Alto"
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Estilo / Categoría *
            </label>
            <select
              id="new-proj-category"
              required
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-sm"
            >
              <option value="minimalista">Minimalismo Cálido</option>
              <option value="madera-piedra">Madera & Piedra</option>
              <option value="isla-central">Isla Central</option>
              <option value="abierta">Abierta al Salón</option>
            </select>
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Ubicación *
            </label>
            <input
              type="text"
              id="new-proj-location"
              required
              placeholder="Ej. La Cabrera, Bogotá"
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Materiales Destacados *
            </label>
            <input
              type="text"
              id="new-proj-materials"
              required
              placeholder="Ej. Travertino, Roble macizo, Herrajes Blum"
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-sm"
            />
          </div>

          <div class="md:col-span-2">
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Descripción Breve
            </label>
            <textarea
              id="new-proj-desc"
              rows="2"
              placeholder="Descripción del concepto arquitectónico..."
              class="w-full px-4 py-3 rounded-xl bg-filippo-linen/50 border border-filippo-stone/80 text-sm resize-none"
            ></textarea>
          </div>

          <div class="md:col-span-2">
            <label class="block text-xs uppercase tracking-wider font-semibold text-filippo-charcoal mb-2">
              Fotografía de la Cocina * (JPG, PNG o WebP)
            </label>
            <input
              type="file"
              id="new-proj-file"
              accept="image/*"
              required
              class="w-full text-xs text-filippo-charcoal file:mr-4 file:py-2.5 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-filippo-charcoal file:text-white hover:file:bg-filippo-dark cursor-pointer"
            />
            <p class="text-[11px] text-filippo-muted mt-2">
              ✓ Compresión y optimización WebP automática activada.
            </p>
          </div>

          <div class="md:col-span-2">
            <button
              type="submit"
              id="btn-upload-project"
              class="bg-filippo-oak hover:bg-filippo-oak-dark text-white px-6 py-3 rounded-full text-xs uppercase tracking-wider font-semibold shadow-md transition-colors"
            >
              + Subir e Incorporar Proyecto
            </button>
          </div>
        </form>
      </div>

      <!-- Lista de proyectos actuales -->
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft">
        <h3 class="font-serif text-xl font-bold text-filippo-charcoal mb-4">
          Proyectos Actualmente en la Galería
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="admin-projects-list">
          {siteContent.gallery.projects.map((p) => (
            <div class="border border-filippo-stone/70 rounded-xl overflow-hidden bg-filippo-linen/30 flex flex-col justify-between" data-id={p.id}>
              <div>
                <img src={p.image} alt={p.title} class="w-full h-40 object-cover" />
                <div class="p-4">
                  <h4 class="font-serif font-bold text-base text-filippo-charcoal">{p.title}</h4>
                  <span class="inline-block text-[10px] uppercase font-semibold text-filippo-oak mt-0.5">{p.categoryLabel}</span>
                  <p class="text-xs text-filippo-muted mt-2 line-clamp-2">{p.description}</p>
                </div>
              </div>
              <div class="p-4 pt-0">
                <button
                  type="button"
                  class="btn-delete-project w-full text-xs text-red-600 hover:text-white hover:bg-red-600 border border-red-200 py-1.5 rounded-lg transition-colors"
                  data-id={p.id}
                >
                  Eliminar de la Galería
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- =========================================================================
     * PESTAÑA 4: PREGUNTAS FRECUENTES (FAQ)
     * ========================================================================= -->
    <div id="tab-faqs" class="tab-panel hidden space-y-6">
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft">
        <h2 class="font-serif text-xl font-bold text-filippo-charcoal mb-6">
          Preguntas Frecuentes Activas
        </h2>

        <div class="space-y-6" id="admin-faqs-list">
          {siteContent.faq.items.map((item, idx) => (
            <div class="p-4 rounded-xl border border-filippo-stone/60 bg-filippo-linen/20 space-y-3 faq-item-box" data-idx={idx}>
              <div>
                <label class="block text-[11px] uppercase tracking-wider font-semibold text-filippo-charcoal mb-1">
                  Pregunta #{idx + 1}
                </label>
                <input
                  type="text"
                  class="faq-q-input w-full px-3 py-2 rounded-lg bg-white border border-filippo-stone/70 text-sm font-semibold"
                  value={item.question}
                />
              </div>
              <div>
                <label class="block text-[11px] uppercase tracking-wider font-semibold text-filippo-charcoal mb-1">
                  Respuesta Detallada
                </label>
                <textarea
                  rows="3"
                  class="faq-a-input w-full px-3 py-2 rounded-lg bg-white border border-filippo-stone/70 text-sm resize-none"
                >{item.answer}</textarea>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- =========================================================================
     * PESTAÑA 5: TESTIMONIOS
     * ========================================================================= -->
    <div id="tab-testimonials" class="tab-panel hidden space-y-6">
      <div class="bg-filippo-white p-6 sm:p-8 rounded-2xl border border-filippo-stone/80 shadow-soft">
        <h2 class="font-serif text-xl font-bold text-filippo-charcoal mb-6">
          Testimonios de Clientes
        </h2>

        <div class="space-y-6" id="admin-testimonials-list">
          {siteContent.testimonials.items.map((item, idx) => (
            <div class="p-4 rounded-xl border border-filippo-stone/60 bg-filippo-linen/20 space-y-3 test-item-box" data-idx={idx}>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-[11px] uppercase tracking-wider font-semibold text-filippo-charcoal mb-1">
                    Nombre del Cliente
                  </label>
                  <input
                    type="text"
                    class="test-author-input w-full px-3 py-2 rounded-lg bg-white border border-filippo-stone/70 text-sm font-semibold"
                    value={item.author}
                  />
                </div>
                <div>
                  <label class="block text-[11px] uppercase tracking-wider font-semibold text-filippo-charcoal mb-1">
                    Ubicación y Tipo de Proyecto
                  </label>
                  <input
                    type="text"
                    class="test-loc-input w-full px-3 py-2 rounded-lg bg-white border border-filippo-stone/70 text-sm"
                    value={item.location}
                  />
                </div>
              </div>
              <div>
                <label class="block text-[11px] uppercase tracking-wider font-semibold text-filippo-charcoal mb-1">
                  Cita / Testimonio
                </label>
                <textarea
                  rows="2"
                  class="test-quote-input w-full px-3 py-2 rounded-lg bg-white border border-filippo-stone/70 text-sm resize-none"
                >{item.quote}</textarea>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>

  <!-- Script cliente del Dashboard CMS -->
  <script define:vars={{ initialData: siteContent }}>
    let currentData = initialData;

    // Control de pestañas
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        tabButtons.forEach((b) => {
          b.classList.remove('bg-filippo-charcoal', 'text-white');
          b.classList.add('bg-filippo-white', 'text-filippo-charcoal/70');
        });
        btn.classList.add('bg-filippo-charcoal', 'text-white');
        btn.classList.remove('bg-filippo-white', 'text-filippo-charcoal/70');

        tabPanels.forEach((p) => {
          if (p.id === targetTab) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // Función toast de retroalimentación
    function showToast(msg, isSuccess = true) {
      const toast = document.getElementById('admin-toast');
      const toastMsg = document.getElementById('admin-toast-msg');
      const toastIcon = document.getElementById('admin-toast-icon');

      if (toast && toastMsg && toastIcon) {
        toastMsg.textContent = msg;
        toastIcon.textContent = isSuccess ? '✓' : '✕';
        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 3500);
      }
    }

    // Guardado general de cambios
    const saveBtn = document.getElementById('save-all-btn');

    if (saveBtn) {
      saveBtn.addEventListener('click', async () => {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Guardando...';

        try {
          // 1. Recoger datos de WhatsApp y marca
          currentData.whatsapp.number = document.getElementById('field-wa-number').value.trim();
          currentData.whatsapp.defaultMessages.floatingButton = document.getElementById('field-wa-float').value.trim();
          currentData.whatsapp.defaultMessages.hero = document.getElementById('field-wa-hero').value.trim();

          currentData.brand.name = document.getElementById('field-brand-name').value.trim();
          currentData.brand.phoneDisplay = document.getElementById('field-brand-phone').value.trim();
          currentData.brand.email = document.getElementById('field-brand-email').value.trim();
          currentData.brand.address = document.getElementById('field-brand-address').value.trim();
          currentData.brand.schedule = document.getElementById('field-brand-schedule').value.trim();

          // 2. Recoger datos del Hero
          currentData.hero.headline = document.getElementById('field-hero-headline').value.trim();
          currentData.hero.subheadline = document.getElementById('field-hero-subheadline').value.trim();
          currentData.hero.ctaText = document.getElementById('field-hero-cta').value.trim();
          currentData.hero.badgeText = document.getElementById('field-hero-badge').value.trim();

          // 3. Recoger FAQs
          const faqBoxes = document.querySelectorAll('.faq-item-box');
          faqBoxes.forEach((box, i) => {
            const q = box.querySelector('.faq-q-input').value.trim();
            const a = box.querySelector('.faq-a-input').value.trim();
            if (currentData.faq.items[i]) {
              currentData.faq.items[i].question = q;
              currentData.faq.items[i].answer = a;
            }
          });

          // 4. Recoger Testimonios
          const testBoxes = document.querySelectorAll('.test-item-box');
          testBoxes.forEach((box, i) => {
            const author = box.querySelector('.test-author-input').value.trim();
            const loc = box.querySelector('.test-loc-input').value.trim();
            const quote = box.querySelector('.test-quote-input').value.trim();
            if (currentData.testimonials.items[i]) {
              currentData.testimonials.items[i].author = author;
              currentData.testimonials.items[i].location = loc;
              currentData.testimonials.items[i].quote = quote;
            }
          });

          // Enviar JSON actualizado al endpoint
          const res = await fetch('/api/admin/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentData)
          });

          const resData = await res.json();
          if (res.ok && resData.success) {
            showToast('¡Cambios guardados con éxito en Filippo!');
          } else {
            showToast(resData.message || 'Error al guardar', false);
          }
        } catch (err) {
          showToast('Error de conexión al guardar cambios', false);
        } finally {
          saveBtn.disabled = false;
          saveBtn.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            <span>Guardar Cambios</span>
          `;
        }
      });
    }

    // Subida de imagen y nuevo proyecto a la galería
    const addProjectForm = document.getElementById('add-project-form');
    const uploadBtn = document.getElementById('btn-upload-project');

    if (addProjectForm) {
      addProjectForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        uploadBtn.disabled = true;
        uploadBtn.textContent = 'Optimizando imagen...';

        const fileInput = document.getElementById('new-proj-file');
        const file = fileInput.files[0];

        if (!file) {
          showToast('Por favor selecciona una imagen', false);
          uploadBtn.disabled = false;
          return;
        }

        try {
          // 1. Subir y procesar imagen en WebP
          const formData = new FormData();
          formData.append('file', file);

          const uploadRes = await fetch('/api/admin/upload', {
            method: 'POST',
            body: formData
          });

          const uploadData = await uploadRes.json();

          if (!uploadRes.ok || !uploadData.success) {
            throw new Error(uploadData.message || 'Fallo en optimización de imagen');
          }

          // 2. Crear objeto del proyecto
          const categorySelect = document.getElementById('new-proj-category');
          const categoryId = categorySelect.value;
          const categoryLabel = categorySelect.options[categorySelect.selectedIndex].text;

          const newProject = {
            id: 'proj-' + Date.now(),
            title: document.getElementById('new-proj-title').value.trim(),
            category: categoryId,
            categoryLabel: categoryLabel,
            image: uploadData.url,
            imageAlt: `Cocina Filippo modelo ${document.getElementById('new-proj-title').value.trim()}`,
            description: document.getElementById('new-proj-desc').value.trim() || 'Proyecto de cocina a medida diseñado e instalado por Filippo.',
            materials: document.getElementById('new-proj-materials').value.trim(),
            location: document.getElementById('new-proj-location').value.trim()
          };

          currentData.gallery.projects.unshift(newProject);

          // 3. Guardar cambios en el servidor
          await fetch('/api/admin/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentData)
          });

          showToast('Proyecto subido y optimizado en WebP');
          setTimeout(() => window.location.reload(), 1200);
        } catch (err) {
          showToast(err.message || 'Error al procesar el proyecto', false);
          uploadBtn.disabled = false;
          uploadBtn.textContent = '+ Subir e Incorporar Proyecto';
        }
      });
    }

    // Eliminación de proyectos
    const deleteButtons = document.querySelectorAll('.btn-delete-project');
    deleteButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const projId = btn.getAttribute('data-id');
        if (!confirm('¿Seguro que deseas eliminar este proyecto de la galería pública?')) return;

        currentData.gallery.projects = currentData.gallery.projects.filter((p) => p.id !== projId);

        try {
          await fetch('/api/admin/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentData)
          });
          showToast('Proyecto eliminado de la galería');
          btn.closest('[data-id]')?.remove();
        } catch (e) {
          showToast('Error al eliminar proyecto', false);
        }
      });
    });
  </script>
</AdminLayout>
