---
/**
 * ==============================================================================
 * FILIPPO | PLANTILLA VISUAL DE PRODUCTO: src/pages/[slug].astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Página dinámica hipervisual para cada línea de producto (/cocinas, /puertas-blindadas,
 * /remodelacion-arquitectonica, etc.).
 *
 * CARACTERÍSTICAS:
 * - Menos texto y más protagonismo visual de fotografías y acabados.
 * - Soporte especial para subcategorías visuales (ej. Remodelación de Baños, Cocinas, Patios).
 * - Sin bloques extensos de proceso; botón de WhatsApp siempre visible y accesible.
 * - Barra fija de cotización inferior en dispositivos móviles.
 * ==============================================================================
 */

import Layout from '../layouts/Layout.astro';
import Footer from '../components/navigation/Footer.astro';
import LightboxModal from '../components/widgets/LightboxModal.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/common/Button.astro';
import siteContent from '../data/siteContent.json';
import { getWhatsAppUrl } from '../utils/whatsapp';

// Obtener el slug de la URL
const { slug } = Astro.params;

// Buscar el producto correspondiente
const products = siteContent.products || [];
const product = products.find((p) => p.slug === slug && p.published);

// Redirigir si no existe
if (!product) {
  return Astro.redirect('/');
}

// Enlace de WhatsApp principal con mensaje personalizado del producto
const productWaUrl = getWhatsAppUrl(
  product.whatsappMessage || `Hola Filippo, me interesa cotizar ${product.title}. ¿Podemos coordinar una asesoría?`
);

// Productos relacionados
const relatedProducts = products
  .filter((p) => p.slug !== product.slug && p.published)
  .slice(0, 3);
---

<Layout
  title={`${product.seoTitle || product.title} | ${siteContent.brand.name}`}
  description={product.seoDescription || product.shortDescription}
  ogImage={product.image}
>
  <!-- Cabecera mínima: navegación directa sin distracciones -->
  <header class="sticky top-0 z-40 w-full glass-header border-b border-filippo-charcoal/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="text-xs uppercase tracking-wider font-semibold text-filippo-muted hover:text-filippo-charcoal flex items-center gap-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Inicio</span>
        </a>
        <span class="text-filippo-stone/80">/</span>
        <span class="text-xs font-semibold text-filippo-charcoal">{product.title}</span>
      </div>

      <!-- Botón de cotizar en la barra superior -->
      <a
        href={productWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-whatsapp hover:bg-whatsapp-dark text-white text-xs uppercase tracking-wider font-semibold px-4 py-2 rounded-full transition-all shadow-sm"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>Cotizar</span>
      </a>
    </div>
  </header>

  <main class="pb-24 md:pb-0">
    <!-- 1. HERO VISUAL DE IMPACTO -->
    <section class="relative pt-10 pb-16 md:pt-16 md:pb-24 bg-filippo-linen overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest-caps text-filippo-oak">
              LÍNEA DE DISEÑO & AUTOR
            </span>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-filippo-charcoal tracking-tight leading-[1.12]">
              {product.title}
            </h1>

            <p class="text-lg text-filippo-muted leading-relaxed font-light max-w-xl mx-auto lg:mx-0">
              {product.tagline || product.shortDescription}
            </p>

            <!-- Botón de cotizar destacado en Hero -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <Button
                href={productWaUrl}
                variant="wa"
                size="lg"
                isExternal={true}
                className="w-full sm:w-auto shadow-md"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
                <span>Cotizar por WhatsApp</span>
              </Button>
            </div>
            <p class="text-xs text-filippo-muted">
              ✓ Fabricación a medida · Respuesta rápida · Asesoría personalizada
            </p>
          </div>

          <!-- Fotografía insignia -->
          <div class="lg:col-span-6">
            <div class="rounded-2xl overflow-hidden shadow-card aspect-[4/3] bg-filippo-cream">
              <img
                src={product.image}
                alt={product.title}
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. SUBCATEGORÍAS VISUALES (ESPECIAL PARA REMODELACIÓN Y PRODUCTOS CON MÚLTIPLES ÁREAS) -->
    {product.subcategories && product.subcategories.length > 0 && (
      <section class="py-16 md:py-24 bg-filippo-white border-t border-filippo-stone/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <SectionHeader
            kicker="ÁREAS DE ESPECIALIDAD"
            title={`¿Qué espacio deseas renovar?`}
            description="Selecciona el área de tu interés para recibir asesoría enfocada y cotización inmediata."
            align="center"
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {product.subcategories.map((sub) => {
              const subWaUrl = getWhatsAppUrl(
                sub.whatsappMessage || `Hola Filippo, me interesa cotizar ${sub.title}.`
              );
              return (
                <div class="bg-filippo-linen/40 rounded-2xl overflow-hidden border border-filippo-stone/70 shadow-soft hover:shadow-card transition-all duration-300 flex flex-col justify-between group">
                  <div>
                    <div class="aspect-[4/3] overflow-hidden bg-filippo-cream relative">
                      <img
                        src={sub.image}
                        alt={sub.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    </div>
                    <div class="p-5">
                      <h3 class="font-serif font-bold text-lg text-filippo-charcoal mb-2 group-hover:text-filippo-oak transition-colors">
                        {sub.title}
                      </h3>
                      <p class="text-xs text-filippo-muted leading-relaxed font-light">
                        {sub.description}
                      </p>
                    </div>
                  </div>

                  <div class="p-5 pt-0">
                    <a
                      href={subWaUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full inline-flex items-center justify-center gap-1.5 bg-whatsapp hover:bg-whatsapp-dark text-white text-xs font-semibold py-2.5 px-3 rounded-xl transition-all shadow-sm"
                    >
                      <span>Cotizar {sub.title}</span>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 3. GALERÍA VISUAL DE GRAN FORMATO -->
    {product.gallery && product.gallery.length > 0 && (
      <section class="py-16 md:py-24 bg-filippo-linen border-t border-filippo-stone/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <SectionHeader
            kicker="PORTAFOLIO FOTOGRÁFICO"
            title={`Galería de ${product.title}`}
            description="Toca cualquier imagen para ampliar detalles, texturas y acabados."
            align="center"
          />

          <!-- Cuadrícula fotográfica protagónica -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {product.gallery.map((imgUrl, i) => (
              <div
                class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-filippo-cream border border-filippo-stone/70 shadow-soft cursor-pointer gallery-trigger-zoom group"
                data-img={imgUrl}
                data-title={`${product.title} - Detalle ${i + 1}`}
                data-alt={`Detalle de ${product.title}`}
              >
                <img
                  src={imgUrl}
                  alt={`${product.title} - Detalle ${i + 1}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-filippo-charcoal/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            ))}
          </div>

          <!-- Llamada a la acción intermedia -->
          <div class="mt-12 text-center">
            <Button
              href={productWaUrl}
              variant="wa"
              size="md"
              isExternal={true}
              className="shadow-md inline-flex"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
              <span>Me interesa un diseño como estos</span>
            </Button>
          </div>
        </div>
      </section>
    )}

    <!-- 4. ACABADOS / MODELOS VISUALES -->
    {product.options && product.options.length > 0 && (
      <section class="py-16 md:py-24 bg-filippo-white border-t border-filippo-stone/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <SectionHeader
            kicker="ACABADOS Y CONFIGURACIONES"
            title="Líneas y acabados disponibles"
            align="center"
          />

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {product.options.map((opt) => (
              <div class="p-6 rounded-2xl bg-filippo-linen/40 border border-filippo-stone/70 flex flex-col justify-between">
                <div>
                  <h3 class="text-lg font-serif font-bold text-filippo-charcoal mb-2">
                    {opt.name}
                  </h3>
                  <p class="text-xs text-filippo-muted leading-relaxed font-light mb-6">
                    {opt.description}
                  </p>
                </div>
                <a
                  href={getWhatsAppUrl(`Hola Filippo, me interesa cotizar la opción '${opt.name}' para ${product.title}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold py-2.5 px-4 rounded-xl border border-filippo-charcoal/30 text-filippo-charcoal hover:bg-filippo-charcoal hover:text-white transition-all text-center"
                >
                  Consultar {opt.name}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 5. PREGUNTAS FRECUENTES BREVES -->
    {product.faqs && product.faqs.length > 0 && (
      <section class="py-16 md:py-20 bg-filippo-cream/40 border-t border-filippo-stone/40">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <SectionHeader
            kicker="PREGUNTAS HABITUALES"
            title={`Dudas frecuentes`}
            align="center"
          />

          <div class="space-y-4">
            {product.faqs.map((faqItem) => (
              <details class="group bg-filippo-white border border-filippo-stone/70 rounded-xl p-5">
                <summary class="font-serif font-bold text-base text-filippo-charcoal cursor-pointer list-none flex items-center justify-between gap-4">
                  <span>{faqItem.question}</span>
                  <span class="text-filippo-oak group-open:rotate-180 transition-transform">↓</span>
                </summary>
                <p class="text-xs sm:text-sm text-filippo-muted font-light leading-relaxed pt-3 border-t border-filippo-stone/30 mt-3">
                  {faqItem.answer}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 6. OTRAS LÍNEAS RELACIONADAS -->
    {relatedProducts.length > 0 && (
      <section class="py-16 md:py-24 bg-filippo-linen border-t border-filippo-stone/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <SectionHeader
            kicker="EXPLORA MÁS"
            title="Otras especialidades de Filippo"
            align="center"
          />

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedProducts.map((rel) => (
              <a
                href={`/${rel.slug}`}
                class="bg-filippo-white rounded-2xl overflow-hidden border border-filippo-stone/70 hover:shadow-card transition-all duration-300 group block"
              >
                <div class="aspect-[4/3] bg-filippo-cream overflow-hidden">
                  <img
                    src={rel.image}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-5">
                  <h3 class="font-serif font-bold text-base text-filippo-charcoal group-hover:text-filippo-oak transition-colors mb-1">
                    {rel.title}
                  </h3>
                  <span class="inline-block text-xs font-semibold text-filippo-oak mt-2">
                    Ver proyectos →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <!-- 7. BARRA FIJA INFERIOR EN MÓVILES (SIEMPRE DISPONIBLE PARA TRÁFICO DE ANUNCIOS/REELS) -->
  <div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-filippo-white/95 backdrop-blur-md border-t border-filippo-stone/80 p-3 px-4 flex items-center justify-between gap-3 shadow-floating">
    <div>
      <p class="text-[10px] uppercase tracking-wider text-filippo-muted font-bold">Atención Inmediata</p>
      <p class="text-xs font-serif font-bold text-filippo-charcoal line-clamp-1">{product.title}</p>
    </div>
    <a
      href={productWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 bg-whatsapp hover:bg-whatsapp-dark text-white text-xs uppercase tracking-wider font-semibold py-3 px-5 rounded-full shadow-md shrink-0"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
      </svg>
      <span>Cotizar</span>
    </a>
  </div>

  <Footer />
  <LightboxModal />
</Layout>
