---
/**
 * ==============================================================================
 * FILIPPO | PLANTILLA VISUAL DE PRODUCTO: src/pages/[slug].astro
 * ------------------------------------------------------------------------------
 * PROPÓSITO:
 * Página dinámica hipervisual para cada línea de producto (/cocinas, /puertas-blindadas,
 * /remodelacion-arquitectonica, etc.).
 *
 * CARACTERÍSTICAS:
 * - Menos texto y más protagonismo visual de fotografías y acabados.
 * - Soporte especial para subcategorías visuales (ej. Remodelación de Baños, Cocinas, Patios).
 * - Sin bloques extensos de proceso; botón de WhatsApp siempre visible y accesible.
 * - Barra fija de cotización inferior en dispositivos móviles.
 * ==============================================================================
 */

import Layout from '../layouts/Layout.astro';
import Footer from '../components/navigation/Footer.astro';
import LightboxModal from '../components/widgets/LightboxModal.astro';
import WhatsAppFloat from '../components/widgets/WhatsAppFloat.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/common/Button.astro';
import siteContent from '../data/siteContent.json';
import { getWhatsAppUrl } from '../utils/whatsapp';

// Generar rutas estáticas para cada producto publicado
export async function getStaticPaths() {
  const products = siteContent.products || [];
  return products
    .filter((product) => product.published)
    .map((product) => ({
      params: { slug: product.slug },
      props: { product },
    }));
}

const { product } = Astro.props;
const products = siteContent.products || [];

// Enlace de WhatsApp principal con mensaje personalizado del producto
const productWaUrl = getWhatsAppUrl(
  product.whatsappMessage || `Hola Filippo, me interesa cotizar ${product.title}. ¿Podemos coordinar una asesoría?`
);

// Productos relacionados
const relatedProducts = products
  .filter((p) => p.slug !== product.slug && p.published)
  .slice(0, 3);
---

<Layout
  title={`${product.seoTitle || product.title} | ${siteContent.brand.name}`}
  description={product.seoDescription || product.shortDescription}
  ogImage={product.image}
>
  <!-- Cabecera: flex justify-between + mayor padding horizontal para alejar de esquinas -->
  <header class="sticky top-0 z-40 w-full glass-header border-b border-filippo-charcoal/5">
    <div class=" px-8 sm:px-12 lg:px-20 h-20 relative flex items-center justify-between">

      <!-- Izquierda: Navegación / Migas de pan -->
      <div class="flex items-center gap-2 min-w-0 z-10">
        <a href="/" class="text-xs uppercase tracking-wider font-semibold text-filippo-muted hover:text-filippo-charcoal flex items-center gap-1.5 transition-colors shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="hidden sm:inline">Inicio</span>
        </a>
        <span class="text-filippo-stone/80 text-xs hidden sm:inline shrink-0">/</span>
        <span class="text-xs font-semibold text-filippo-charcoal max-w-[80px] sm:max-w-[160px] md:max-w-[260px] truncate">{product.title}</span>
      </div>

      <!-- Centro: Logotipo centrado (conservando position: relative según indicación) -->
      <div class="flex flex-col items-center z-0 pointer-events-none">
        <a href="/" class="inline-flex flex-col items-center group focus:outline-none pointer-events-auto" aria-label="Ir al inicio de Filippo">
          {siteContent.brand.logoUrl ? (
            <img src={siteContent.brand.logoUrl} alt={siteContent.brand.name} class="h-10 w-auto object-contain" />
          ) : (
            <div class="flex flex-col items-center leading-none">
              <span class="font-serif text-xl tracking-[0.2em] text-filippo-charcoal uppercase font-bold group-hover:text-filippo-oak transition-colors">
                {siteContent.brand.name}
              </span>
            </div>
          )}
        </a>
      </div>

      <!-- Derecha: Botón cotizar (oculto en móviles para una cabecera limpia) -->
      <div class="z-10 shrink-0 hidden sm:block">
        <a
          href={productWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-filippo-oak hover:bg-filippo-oak-dark text-black text-xs uppercase tracking-wider font-semibold px-4 py-2 rounded-full transition-all shadow-sm"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
          <span>Cotizar Proyecto</span>
        </a>
      </div>

    </div>
  </header>

  <main class="pb-24 md:pb-0">
    <!-- 1. HERO ENFOCADO EN VENTAS (ESTILO APPLE: IMAGEN PRIMERO) -->
    <section class="relative pt-6 sm:pt-10 pb-16 md:pb-24 overflow-hidden bg-filippo-linen flex flex-col items-center">
      <!-- Imagen Visual de Alto Impacto Primero -->
      <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 mb-12 sm:mb-16 md:mb-20">
        <div class="relative overflow-hidden rounded-3xl md:rounded-[2.5rem] shadow-2xl aspect-[4/3] sm:aspect-[16/10] lg:aspect-[21/9] bg-filippo-cream group">
          <img
            src={product.image}
            alt={product.title}
            class="w-full h-full object-cover object-center transform group-hover:scale-[1.02] transition-transform duration-1000 ease-out"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>
        </div>
      </div>

      <!-- Información tipográfica y conversión -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-filippo-charcoal/5 border border-filippo-charcoal/10 mb-6">
          <span class="text-xs font-semibold uppercase tracking-widest text-filippo-charcoal">
            {product.badgeText || "Diseño exclusivo y a medida"}
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif text-filippo-charcoal tracking-tight leading-[1.08] mb-6 sm:mb-8">
          {product.title}
        </h1>

        <p class="text-base sm:text-xl lg:text-2xl text-filippo-muted leading-relaxed font-light max-w-2xl mx-auto mb-10 sm:mb-12">
          {product.tagline || product.shortDescription}
        </p>

        <!-- Botón de cotizar destacado en Hero -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button
            href={productWaUrl}
            variant="wa"
            size="lg"
            isExternal={true}
            className="w-full sm:w-auto shadow-md hover:shadow-floating"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
            <span>Cotizar Proyecto</span>
          </Button>
        </div>
      </div>
    </section>

    <!-- 2. SUBCATEGORÍAS VISUALES (ESPECIAL PARA REMODELACIÓN Y PRODUCTOS CON MÚLTIPLES ÁREAS) -->
    {product.subcategories && product.subcategories.length > 0 && (
      <section class="py-20 md:py-28 bg-filippo-white border-t border-filippo-stone/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <SectionHeader
            kicker="ÁREAS DE ESPECIALIDAD"
            title={`¿Qué espacio deseas renovar?`}
            description="Selecciona el área de tu interés para recibir asesoría enfocada y cotización inmediata."
            align="center"
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
            {product.subcategories.map((sub) => {
              const subWaUrl = getWhatsAppUrl(
                sub.whatsappMessage || `Hola Filippo, me interesa cotizar ${sub.title}.`
              );
              return (
                <article class="group relative overflow-hidden rounded-3xl bg-black">
                  <div class="block relative aspect-square overflow-hidden">
                    <img
                      src={sub.image}
                      alt={sub.title}
                      class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                  </div>
                  <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 flex flex-col items-center text-center">
                    <h3 class="text-2xl font-serif text-white mb-4">
                      {sub.title}
                    </h3>
                    <a
                      href={subWaUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full inline-flex items-center justify-center gap-1.5 text-xs font-bold uppercase tracking-wider py-3 rounded-full bg-white/10 hover:bg-filippo-oak hover:text-black text-white transition-colors backdrop-blur-md"
                    >
                      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.761.815 2.791.815 3.179 0 5.766-2.587 5.767-5.767.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.14.394-.71.748-1.025.795-.295.044-.68.064-1.104-.072-.267-.086-.605-.205-1.037-.393-1.834-.799-3.031-2.656-3.123-2.778-.092-.122-.744-.991-.744-1.89 0-.898.471-1.341.639-1.523.167-.183.364-.229.486-.229.121 0 .243.001.35.006.113.005.263-.043.411.313.155.372.529 1.29.575 1.383.046.092.076.2.015.322-.061.122-.092.198-.183.305-.092.107-.193.24-.275.322-.092.091-.188.191-.081.374.107.183.475.784 1.02 1.269.702.625 1.295.818 1.479.91.183.091.29.076.397-.046.107-.122.457-.533.579-.716.122-.183.244-.153.411-.092.168.061 1.066.503 1.249.594.183.091.305.137.35.213.045.076.045.442-.095.836zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                      </svg>
                      <span>Cotizar</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 3. GALERÍA VISUAL DE GRAN FORMATO -->
    {product.gallery && product.gallery.length > 0 && (
      <section class="py-20 md:py-32 bg-filippo-linen">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-16 md:mb-20 text-center mx-auto max-w-3xl">
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-filippo-charcoal tracking-tight leading-[1.1] mb-6">
              Galería
            </h2>
          </div>

          <!-- Cuadrícula fotográfica sin bordes -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-4">
            {product.gallery.map((imgUrl, i) => (
              <div
                class="relative aspect-square md:aspect-[4/5] overflow-hidden bg-filippo-cream cursor-pointer gallery-trigger-zoom group"
                data-img={imgUrl}
                data-title={`${product.title} - Detalle ${i + 1}`}
                data-alt={`Detalle de ${product.title}`}
              >
                <img
                  src={imgUrl}
                  alt={`${product.title} - Detalle ${i + 1}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center text-white">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 4. ACABADOS / MODELOS VISUALES -->
    {product.options && product.options.length > 0 && (
      <section class="py-20 md:py-32 bg-black text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-16 md:mb-20 text-center mx-auto max-w-3xl">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest text-white/50 mb-4">
              ACABADOS Y CONFIGURACIONES
            </span>
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight leading-[1.1] mb-6">
              Líneas y acabados
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {product.options.map((opt) => (
              <div class="p-8 md:p-10 bg-white/5 flex flex-col justify-between hover:bg-white/10 transition-colors duration-500">
                <div>
                  <h3 class="text-2xl font-serif mb-4">
                    {opt.name}
                  </h3>
                  <p class="text-sm text-gray-400 leading-relaxed font-light mb-10">
                    {opt.description}
                  </p>
                </div>
                <a
                  href={getWhatsAppUrl(`Hola Filippo, me interesa cotizar la opción '${opt.name}' para ${product.title}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-wider py-4 px-6 rounded-full bg-white text-black hover:bg-filippo-oak transition-all text-center"
                >        
                  Consultar {opt.name}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 5. PREGUNTAS FRECUENTES BREVES -->
    {product.faqs && product.faqs.length > 0 && (
      <section class="py-20 md:py-32 bg-black">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-16 md:mb-20 text-center mx-auto max-w-3xl">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest text-white/50 mb-4">
              PREGUNTAS HABITUALES
            </span>
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white tracking-tight leading-[1.1] mb-6">
              Dudas frecuentes
            </h2>
            <p class="text-base md:text-lg text-gray-400 leading-relaxed font-light">
              Resolvemos tus preguntas sobre personalización, acabados y tiempos de entrega.
            </p>
          </div>

          <div class="mt-12">
            {product.faqs.map((faqItem) => (
              <details class="group border-b border-white/10 transition-all duration-200">
                <summary class="w-full py-6 text-left flex items-center justify-between gap-4 cursor-pointer list-none focus:outline-none">
                  <span class="font-serif text-xl sm:text-2xl text-white group-hover:text-filippo-oak transition-colors">
                    {faqItem.question}
                  </span>
                  <span class="text-white/50 group-hover:text-filippo-oak shrink-0 group-open:rotate-180 transition-transform duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="pb-8 text-base text-gray-400 leading-relaxed font-light">
                  <p>{faqItem.answer}</p>
                </div>
              </details>
            ))}
          </div>

          <!-- Llamada complementaria a WhatsApp -->
          <div class="mt-16 text-center">
            <a
              href={productWaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-filippo-oak transition-colors border-b border-transparent hover:border-filippo-oak pb-1"
            >
              <span>¿Tienes otra consulta? Habla con un diseñador por WhatsApp</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- 6. OTRAS LÍNEAS RELACIONADAS -->
    {relatedProducts.length > 0 && (
      <section class="py-20 md:py-32 bg-filippo-linen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-16 md:mb-20 text-center mx-auto max-w-3xl">
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-filippo-charcoal tracking-tight leading-[1.1] mb-6">
              Otras especialidades
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedProducts.map((rel) => {
              const relWaUrl = getWhatsAppUrl(
                rel.whatsappMessage || `Hola Filippo, me interesa cotizar ${rel.title}.`
              );
              return (
                <article class="group relative overflow-hidden bg-black flex flex-col justify-between">
                  <div class="block relative aspect-square overflow-hidden">
                    <img
                      src={rel.image}
                      alt={rel.title}
                      class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 group-hover:opacity-70 transition-opacity"></div>
                    
                    <div class="absolute bottom-0 left-0 right-0 p-8 flex flex-col items-center text-center">
                      <h3 class="text-2xl font-serif text-white mb-2">
                        <a href={`/${rel.slug}`} class="focus:outline-none">
                          {rel.title}
                        </a>
                      </h3>
                      <p class="text-sm text-gray-300 font-light leading-relaxed mb-6 hidden md:block">
                        {rel.shortDescription}
                      </p>
                      
                      <div class="flex gap-3 w-full">
                        <a
                          href={`/${rel.slug}`}
                          class="flex-1 inline-flex items-center justify-center text-xs font-semibold uppercase tracking-wider py-3 px-3 rounded-full border border-white/30 text-white hover:bg-white hover:text-black transition-all text-center backdrop-blur-sm"
                        >
                          Ver más
                        </a>
                        <a
                          href={relWaUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex-1 inline-flex items-center justify-center gap-1.5 text-xs font-bold uppercase tracking-wider py-3 px-3 rounded-full bg-white/10 hover:bg-filippo-oak hover:text-black text-white transition-all backdrop-blur-sm text-center"
                        >
                          <span>Cotizar</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <!-- 7. BARRA FIJA INFERIOR EN MÓVILES (SIEMPRE DISPONIBLE PARA TRÁFICO DE ANUNCIOS/REELS) -->
  <div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-filippo-white/95 backdrop-blur-md border-t border-filippo-stone/80 p-3 px-4 flex items-center justify-between gap-3 shadow-floating">
    <div>
      <p class="text-[10px] uppercase tracking-wider text-gray-300 font-bold">Atención Inmediata</p>
      <p class="text-xs font-serif font-bold text-filippo-charcoal line-clamp-1">{product.title}</p>
    </div>
    <a
      href={productWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 bg-filippo-oak hover:bg-filippo-oak-dark text-black text-xs uppercase tracking-wider font-bold py-3 px-5 rounded-full shadow-md shrink-0"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
